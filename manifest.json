{
  "manifest_version": 3,
  "name": "Stand Reminder",
  "version": "0.1.0",
  "description": "Lightweight reminder to stand during the day.",
  "permissions": ["notifications", "storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options.html",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Stand Reminder"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
